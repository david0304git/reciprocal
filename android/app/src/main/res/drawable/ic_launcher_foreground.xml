<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: the hourglass mark (chosen design M2 — thin brand-green line art on the
  paper background).

  Traced from the supplied reference: long rounded top/bottom bars, straight shoulders, diagonals
  that meet at a narrow waist with a small gap. Drawn on the 108dp adaptive-icon canvas; the mark
  spans x 36–72 and y 27–81, i.e. inside the 66dp safe circle, so no launcher mask clips it.
  Line width 3.1dp (3.1% of the tile) keeps the thin-line look while staying readable at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- top bar -->
    <path
        android:pathData="M36,27 L72,27"
        android:strokeColor="#27614F"
        android:strokeWidth="3.1"
        android:strokeLineCap="round" />

    <!-- bottom bar -->
    <path
        android:pathData="M36,81 L72,81"
        android:strokeColor="#27614F"
        android:strokeWidth="3.1"
        android:strokeLineCap="round" />

    <!-- left half of the glass -->
    <path
        android:pathData="M37.5,27 L37.5,41 L50.8,57 L37.5,73 L37.5,81"
        android:strokeColor="#27614F"
        android:strokeWidth="3.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- right half of the glass -->
    <path
        android:pathData="M70.5,27 L70.5,41 L57.2,57 L70.5,73 L70.5,81"
        android:strokeColor="#27614F"
        android:strokeWidth="3.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
