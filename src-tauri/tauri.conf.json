{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reciprocal",
  "version": "0.1.0",
  "identifier": "com.lutszhong.reciprocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reciprocal",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#F6F4EF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "個人習慣、日曆與事務追蹤",
    "longDescription": "Reciprocal 是一個專注於日常節奏的個人工具：建立習慣、每日打卡、安排行程，並追蹤待辦事務。所有資料都存在你自己的電腦上。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
